# Copy this file to .env (gitignored) and fill in whichever key(s) you have.
# deploy.sh loads .env automatically before starting the server, so you don't
# need to re-export these every time you redeploy.
#
# None of these are the same as a claude.ai/ChatGPT Plus subscription or an
# Azure account login - all are separate, billed-by-usage credentials from
# that provider's own developer console (console.anthropic.com /
# platform.openai.com / Azure Portal's Speech resource).
#
# You can also skip this file entirely and type a key into the app's own
# "API Keys" panel instead - that's stored in your browser only and needs no
# server-side setup at all.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Azure Speech - powers server-side "Read aloud" in the page review UI.
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=eastus
